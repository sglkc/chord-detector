# Large / generated artifacts under training/
# Keep directory tree in git (via .gitkeep); ignore all other contents.
# Python / .venv / Jupyter ignores live in the repo-root .gitignore.

# Raw audio datasets (training, vivo, thinkpad, archives, side caches)
/datasets/**
!/datasets/**/
!/datasets/**/.gitkeep

# Extracted feature caches (.npz)
/features/**
!/features/**/
!/features/**/.gitkeep

# Trained model weights (.keras, .pkl, etc.)
/models/**
!/models/**/
!/models/**/.gitkeep

# Validation clips + feature packs
/validations/**
!/validations/**/
!/validations/**/.gitkeep

# Evaluation sets + feature packs
/evaluations/**
!/evaluations/**/
!/evaluations/**/.gitkeep

# Noise / IR banks for domain augmentation (raw wavs + source zips)
/noises/**
!/noises/**/
!/noises/**/.gitkeep

# Notebook-local caches
**/misclass-cache/**
!**/misclass-cache/**/
!**/misclass-cache/**/.gitkeep

# Experiment result dirs: keep CSVs, ignore weights / images / caches / logs
**/cnn-eval-results/**
!**/cnn-eval-results/**/
!**/cnn-eval-results/**/*.csv
**/cnn-compare-results/**
!**/cnn-compare-results/**/
!**/cnn-compare-results/**/*.csv
**/cnn-cross-eval-results/**
!**/cnn-cross-eval-results/**/
!**/cnn-cross-eval-results/**/*.csv

**/svm-eval-results/**
!**/svm-eval-results/**/
!**/svm-eval-results/**/*.csv

**/cross-eval-results/**
!**/cross-eval-results/**/
!**/cross-eval-results/**/*.csv
**/variant-results/**
!**/variant-results/**/
!**/variant-results/**/*.csv
**/baseline-results/**
!**/baseline-results/**/
!**/baseline-results/**/*.csv

**/cnn-v2/weights/
**/cnn-v2/weights_extra/
**/cnn-latest/weights/
**/cnn-latest/results/**
!**/cnn-latest/results/**/
!**/cnn-latest/results/**/*.csv
**/cnn-revised/weights/
**/cnn-revised/results/**
!**/cnn-revised/results/**/
!**/cnn-revised/results/**/*.csv

**/svm-latest/results/**
!**/svm-latest/results/**/
!**/svm-latest/results/**/*.csv
**/svm-latest/bundles/

**/onset-latest/*results*/**
!**/onset-latest/*results*/**/
!**/onset-latest/*results*/**/*.csv

**/raw-audio/*results*/**
!**/raw-audio/*results*/**/
!**/raw-audio/*results*/**/*.csv

# Archived / backup experiment dumps
**/*_archive*/
**/*_results-archive*/
**/*backup*/
**/*bak*/

# Batch / tool run logs
/notebooks/*.log

# Exported listen-pack audio (features-faithful wet/dry); keep index/README
/processed-samples/**
!/processed-samples/**/
!/processed-samples/**/.gitkeep
!/processed-samples/**/*.csv
!/processed-samples/**/*.md
