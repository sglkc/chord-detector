# Large / generated artifacts under training/
# Keep directory tree in git (via .gitkeep); ignore all other contents.
# Python / .venv / Jupyter ignores live in the repo-root .gitignore.

# Raw audio datasets (training, vivo, thinkpad, archives, side caches)
/datasets/**
!/datasets/**/
!/datasets/**/.gitkeep

# Extracted feature caches (.npz)
/features/**
!/features/**/
!/features/**/.gitkeep

# Trained model weights (.keras, .pkl, etc.)
/models/**
!/models/**/
!/models/**/.gitkeep

# Validation clips + feature packs
/validations/**
!/validations/**/
!/validations/**/.gitkeep

# Evaluation sets + feature packs
/evaluations/**
!/evaluations/**/
!/evaluations/**/.gitkeep

# Noise / IR banks for domain augmentation (raw wavs + source zips)
/noises/**
!/noises/**/
!/noises/**/.gitkeep

# Notebook-local caches
**/misclass-cache/**
!**/misclass-cache/**/
!**/misclass-cache/**/.gitkeep

# CNN eval / compare / cross-eval artifacts (csv, png, npz caches)
**/cnn-eval-results/
**/cnn-compare-results/
**/cnn-cross-eval-results/

# SVM recorded-eval artifacts
**/svm-eval-results/

# CNN variant retrain / OOD matrix / centroid baseline
**/cross-eval-results/
**/variant-results/
**/baseline-results/
**/cnn-v2/weights/
**/cnn-v2/weights_extra/
**/cnn-latest/weights/
**/cnn-latest/results/

# Batch / tool run logs
/notebooks/*.log

# Exported listen-pack audio (features-faithful wet/dry); keep index/README
/processed-samples/**
!/processed-samples/**/
!/processed-samples/**/.gitkeep
!/processed-samples/**/*.csv
!/processed-samples/**/*.md
